Options -Indexes

<IfModule mod_authz_core.c>
    <FilesMatch "^(\.env.*|\..+|.*\.(sql|sqlite|db|bak|backup|old|orig|pem|key|crt|csr|zip|manifest\.json))$">
        Require all denied
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
