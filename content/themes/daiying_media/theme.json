    "enable_custom_seo": {
      "type": "boolean",
      "label": "SEO｜启用自定义 SEO 设置",
      "default": true
    },
    "show_sidebar": {
      "type": "boolean",
      "label": "侧栏｜启用侧栏",
      "default": true
    },
    "sidebar_modules": {
      "type": "textarea",
      "label": "侧栏｜模块",
      "help": "每行一个模块：搜索、最新文章、热门文章、分类、标签、作者卡片、Newsletter、推荐内容。",
      "default": "搜索\n最新文章\n热门文章\n分类\n标签\n作者卡片\nNewsletter"
    },
    "sidebar_tag_count": {
      "type": "string",
      "label": "侧栏｜热门标签数量",
      "ui": "developer",
      "default": "12"
    },
    "sidebar_hot_days": {
      "type": "string",
      "label": "侧栏｜热门文章统计天数",
      "ui": "developer",
      "default": "30"
    },
    "sidebar_recommend_ids": {
      "type": "string",
      "label": "侧栏｜推荐文章 ID",
