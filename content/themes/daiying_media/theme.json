      "ui": "developer",
      "default": true
    },
    "enable_article_copyright": {
      "type": "boolean",
      "label": "文章｜显示版权声明",
      "default": true
    },
    "enable_scroll_animation": {
      "type": "boolean",
      "label": "文章｜滚动加载特效兼容开关",
      "help": "兼容原 InfoLee 滚动加载特效；市场版默认使用轻量原生交互。",
      "ui": "developer",
      "default": false
    },
    "seo_title_mode": {
      "type": "select",
      "label": "SEO｜标题组合",
      "default": "site",
      "options": {
        "category_site": "文章标题-分类名-网站标题",
        "site": "文章标题-网站标题"
      }
    },
    "seo_site_title": {
      "type": "textarea",
      "label": "SEO｜网站标题",
      "default": ""
    },
    "seo_site_subtitle": {
      "type": "textarea",
      "label": "SEO｜网站副标题",
      "default": ""
    },
    "seo_keywords": {
      "type": "textarea",
      "label": "SEO｜网站关键词",
      "default": ""
    },
    "seo_description": {
      "type": "textarea",
      "label": "SEO｜网站描述",
      "default": ""
