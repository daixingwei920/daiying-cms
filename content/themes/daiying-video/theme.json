{
    "theme_id": "daiying-video",
    "name": "Daiying Video",
    "version": "1.0.0",
    "author": "Daiying CMS",
    "core": {"min": "1.2.0", "max": "1.x"},
    "content_types": ["video", "video_episode", "short_drama"],
    "recommended_plugins": ["official.video-collector"],
    "required_plugins": ["official.video-collector"],
    "package_type": "theme",
    "local_dev": false,
    "market_release": true,
    "settings_schema": {
        "brand_name": {"type": "string", "label": "站点名称", "default": "Daiying Video"},
        "brand_logo_text": {"type": "string", "label": "文字 Logo", "default": "V"},
        "brand_logo_url": {"type": "string", "label": "图片 Logo URL", "default": ""},
        "home_title": {"type": "string", "label": "首页标题", "default": "影视片库"},
        "home_subtitle": {"type": "string", "label": "首页副标题", "default": "电影、电视剧、短剧、动漫、综艺聚合展示，多播放线路按集切换。"},
        "accent_color": {"type": "string", "label": "主色", "default": "#0b7a75"},
        "nav_label_movie": {"type": "string", "label": "导航：电影", "default": "电影"},
        "nav_label_tv": {"type": "string", "label": "导航：电视剧", "default": "电视剧"},
        "nav_label_short_drama": {"type": "string", "label": "导航：短剧", "default": "短剧"},
        "nav_label_anime": {"type": "string", "label": "导航：动漫", "default": "动漫"},
        "nav_label_variety": {"type": "string", "label": "导航：综艺", "default": "综艺"},
        "search_placeholder": {"type": "string", "label": "搜索提示", "default": "搜索片名、演员"},
        "show_search": {"type": "boolean", "label": "显示搜索框", "default": true},
        "show_home_stats": {"type": "boolean", "label": "显示首页统计", "default": true},
        "section_hot_label": {"type": "string", "label": "分区：热门推荐", "default": "热门推荐"},
        "section_playing_label": {"type": "string", "label": "分区：热播", "default": "热播"},
        "section_movies_label": {"type": "string", "label": "分区：最新电影", "default": "最新电影"},
        "section_tv_label": {"type": "string", "label": "分区：电视剧", "default": "电视剧"},
        "section_short_drama_label": {"type": "string", "label": "分区：短剧", "default": "短剧"},
        "section_anime_label": {"type": "string", "label": "分区：动漫", "default": "动漫"},
        "section_variety_label": {"type": "string", "label": "分区：综艺", "default": "综艺"},
        "section_latest_label": {"type": "string", "label": "分区：最近更新", "default": "最近更新"},
        "empty_text": {"type": "string", "label": "空数据文案", "default": "这里还没有可显示的影片。采集入库后会自动显示。"},
        "player_default_source": {"type": "string", "label": "默认播放线路", "default": "auto"},
        "poster_ratio": {"type": "string", "label": "海报比例", "default": "2:3", "enum": ["2:3", "3:4", "16:9"]},
        "enable_favorites": {"type": "boolean", "label": "显示收藏按钮", "default": true},
        "player_autoplay": {"type": "boolean", "label": "播放器自动播放", "default": false}
    }
}
