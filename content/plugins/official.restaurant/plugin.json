{
  "plugin_id": "official.restaurant",
  "name": "餐厅外卖",
  "description": "面向餐厅自取、预约与指定区域送餐的菜单、厨房票据和订单看板插件；实体打印需单独验收。",
  "version": "1.0.1",
  "author": "Daiying CMS",
  "type": "plugin",
  "package_type": "plugin",
  "entry": "plugin.php",
  "core": { "min": "1.2.83", "max": "2.0.0" },
  "php": ">=8.3.0",
  "trust_level": "trusted_php",
  "official": true,
  "capabilities": [
    "commerce.read",
    "commerce.orders",
    "restaurant.manage",
    "restaurant.orders",
    "restaurant.print"
  ],
  "capability_namespaces": ["commerce", "restaurant"],
  "admin_routes": [
    { "label": "餐厅外卖", "path": "/admin/restaurant", "method": "GET" },
    { "label": "菜单管理", "path": "/admin/restaurant/menu", "method": "GET" },
    { "label": "识别菜单", "path": "/admin/restaurant/menu/import", "method": "GET" },
    { "label": "菜单识别草稿", "path": "/admin/restaurant/menu/recognize", "method": "POST" },
    { "label": "核对导入菜单", "path": "/admin/restaurant/menu/import", "method": "POST" },
    { "label": "分类管理", "path": "/admin/restaurant/categories", "method": "GET" },
    { "label": "保存分类", "path": "/admin/restaurant/categories/save", "method": "POST" },
    { "label": "店面设置", "path": "/admin/restaurant/storefront", "method": "GET" },
    { "label": "厨房岗位", "path": "/admin/restaurant/stations", "method": "GET" },
    { "label": "打印机", "path": "/admin/restaurant/printers", "method": "GET" },
    { "label": "设备测试票", "path": "/admin/restaurant/printers/test", "method": "POST" },
    { "label": "现场确认打印", "path": "/admin/restaurant/print-jobs/confirm", "method": "POST" },
    { "label": "打印任务", "path": "/admin/restaurant/print-jobs", "method": "GET" },
    { "label": "同步已支付餐厅订单", "path": "/admin/restaurant/orders/sync-paid", "method": "POST" }
  ],
  "public_routes": [
    { "label": "餐厅菜单", "path": "/restaurant", "method": "GET" },
    { "label": "餐厅店面数据", "path": "/restaurant/api/storefront", "method": "GET" },
    { "label": "餐厅菜单数据", "path": "/restaurant/api/menu", "method": "GET" },
    { "label": "餐厅菜单搜索", "path": "/restaurant/api/menu/search", "method": "GET" },
    { "label": "餐车数据", "path": "/restaurant/api/cart", "method": "GET" },
    { "label": "加入餐车", "path": "/restaurant/api/cart/add", "method": "POST" },
    { "label": "移除餐车商品", "path": "/restaurant/api/cart/remove", "method": "POST" },
    { "label": "修改餐车商品", "path": "/restaurant/api/cart/update", "method": "POST" },
    { "label": "餐厅支付", "path": "/restaurant/checkout", "method": "POST" },
    { "label": "餐厅支付完成", "path": "/restaurant/checkout/complete", "method": "GET" },
    { "label": "打印助手取任务", "path": "/restaurant/agent/jobs", "method": "GET" },
    { "label": "打印助手回执（已停用）", "path": "/restaurant/agent/jobs/report", "method": "POST" },
    { "label": "打印桥设备绑定", "path": "/restaurant/bridge/bindings", "method": "GET" },
    { "label": "打印桥领取任务", "path": "/restaurant/bridge/jobs/claim", "method": "POST" },
    { "label": "打印桥输出前确认", "path": "/restaurant/bridge/jobs/start", "method": "POST" },
    { "label": "打印桥状态回传", "path": "/restaurant/bridge/jobs/report", "method": "POST" }
  ],
  "dependencies": [],
  "required_plugins": ["official.commerce"],
  "migrations": ["migrations/001_restaurant_core.php", "migrations/002_restaurant_checkout.php", "migrations/003_agent_claims.php", "migrations/004_print_bridge.php"],
  "table_prefixes": ["restaurant_"],
  "data_policy": {
    "uninstall": "retain_orders_tickets_and_print_history",
    "purge": "separate_confirmation_only"
  },
  "data_schema_version": "0.1.0-alpha.15"
}
